// test load randomization using Arras runtime class

#ifndef model
#error global variable `model` is not defined
#endif

#system mkdir -p ${model}

#include "${model}/${model}.glm"

// setup an pseudo time-series randomized load trial
clock
{
    timezone "UTC0";
    starttime "2000-01-01 00:00:00 UTC";
    stoptime "2000-01-07 23:59:59 UTC";
}

// format the CSV output in a pandas-friendly way
module tape
{
    csv_header_type NAME;
}

// load the randomizer module
module randomizer;

// create the randomizer class
class randomizer
{
    randomvar scale;
}

#write ${model}/model.json
#python create_loads.py ${model}/model.json ${model}/loads.glm
#include "${model}/loads.glm"

#on_exit 0 python3 concat_results.py ${model}
